<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.CatalogoEmpleadosController">
    <children>

        <VBox layoutY="37.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="37.0">
            <effect>
                <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0" />
            </effect>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <Label styleClass="label-titulo" text="Catálogo de Empleados" textFill="#044c87">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Consulte y administre todos los empleados registrados en el sistema." textFill="#666666" />

                <Separator prefWidth="200.0" />

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtBuscar" prefHeight="30.0" prefWidth="260.0" promptText="Buscar por nombre" />
                        <Button mnemonicParsing="false" onAction="#clicBuscar" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #399ACE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Buscar">
                            <effect>
                                <InnerShadow color="#ffffff40" offsetY="3.0" />
                            </effect>
                        </Button>
                    </children>
                </HBox>
            <TableView fx:id="tv_listado" prefHeight="310.0" prefWidth="818.0">
               <columns>
                  <TableColumn fx:id="col_nombre" prefWidth="98.0" text="Nombre" />
                  <TableColumn fx:id="col_paterno" prefWidth="114.0" text="Apellido Paterno" />
                  <TableColumn fx:id="col_materno" prefWidth="108.0" text="Apellido Materno" />
                  <TableColumn fx:id="col_direccion" prefWidth="155.0" text="Dirección" />
                  <TableColumn fx:id="col_correo" prefWidth="130.0" text="Correo" />
                  <TableColumn fx:id="col_telefono" prefWidth="97.0" text="Teléfono" />
                  <TableColumn fx:id="col_depto" prefWidth="115.0" text="Departamento" />
               </columns>
               <effect>
                  <DropShadow offsetX="-3.0" offsetY="3.0">
                     <color>
                        <Color opacity="0.15" />
                     </color>
                  </DropShadow>
               </effect>
            </TableView>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#clicAgregar" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #044c87; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Agregar">
                            <effect>
                                <InnerShadow color="#ffffff40" offsetY="3.0" />
                            </effect>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#clicModificar" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #399ACE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Modificar">
                            <effect>
                                <InnerShadow color="#ffffff40" offsetY="3.0" />
                            </effect>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#clicEliminar" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #044c87; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Eliminar">
                            <effect>
                                <InnerShadow color="#ffffff40" offsetY="3.0" />
                            </effect>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#clicRegresar" prefHeight="30.0" prefWidth="140.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Regresar">
                            <effect>
                                <InnerShadow color="#ffffff40" offsetY="3.0" />
                            </effect>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
      <MenuBar prefHeight="30.0" prefWidth="907.0">
         <menus>
            <Menu mnemonicParsing="false" text="Ingresos">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#clicRegistrarFactura" text="Registrar factura" />
                  <MenuItem mnemonicParsing="false" text="Consultar facturas" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Items">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#clicRegistrarItem" text="Registrar item" />
                  <MenuItem mnemonicParsing="false" onAction="#clicConsultarItems" text="Consultar items" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Pedidos">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#clicConsultarBitacora" text="Consultar bitácora" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
    </children>
</AnchorPane>
