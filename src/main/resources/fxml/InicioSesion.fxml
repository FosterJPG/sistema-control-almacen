<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="479.0" prefWidth="358.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.InicioSesionController">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15;;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imagenes/logo-financiera.png" />
               </image></ImageView>
            <Label alignment="TOP_CENTER" prefHeight="52.0" prefWidth="73.0" text="Login" textFill="#000000a2">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Label alignment="BOTTOM_CENTER" prefHeight="51.0" prefWidth="67.0" text="Usuario:" />
            <TextField fx:id="tfUsuario" promptText="Ingresa tu usuario" />
            <Label fx:id="lbErrorUsuario" alignment="TOP_CENTER" textFill="RED" />
            <Label alignment="BOTTOM_CENTER" prefHeight="35.0" prefWidth="126.0" text="Contraseña:" />
            <PasswordField fx:id="tfPassword" promptText="Ingresa tu contraseña" />
            <Label fx:id="lbErrorPassword" alignment="TOP_CENTER" textFill="RED" />
            <Button mnemonicParsing="false" onAction="#btnIniciarSesion" text="Iniciar Sesion">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <effect>
            <DropShadow color="#0000006f" offsetX="-3.0" offsetY="3.0" />
         </effect>
      </VBox>
   </children>
</AnchorPane>
