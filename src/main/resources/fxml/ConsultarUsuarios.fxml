<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.effect.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root id="AnchorPane" prefHeight="400.0" prefWidth="600.0" type="AnchorPane" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.ConsultarUsuariosController">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 10;;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <effect>
            <DropShadow color="#00000060" offsetX="-3.0" offsetY="3.0" />
         </effect>
         <top>
            <VBox prefHeight="105.0" prefWidth="560.0" spacing="10.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label text="Catálogo de Usuarios Registrados">
                     <font>
                        <Font name="Segoe UI Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label text="Use el filtro para localizar usuarios por ID o nombre de empleado." />
                  <HBox alignment="CENTER_LEFT" prefHeight="48.0" prefWidth="530.0" spacing="10.0">
                     <children>
                        <Label text="Buscar:" />
                        <TextField HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </top>
         <center>
            <TableView prefHeight="178.0" prefWidth="560.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn prefWidth="76.0" text="ID" />
                <TableColumn prefWidth="203.0" text="Nombre Empleado" />
                  <TableColumn prefWidth="83.0" text="Rol Asignado" />
                  <TableColumn prefWidth="91.0" text="Fecha Registro" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </center>
         <bottom>
            <HBox alignment="CENTER_RIGHT" prefHeight="0.0" prefWidth="560.0" spacing="15.0" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Button mnemonicParsing="false" text="Editar Perfil" />
                  <Button mnemonicParsing="false" text="Baja de Usuario" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</fx:root>
