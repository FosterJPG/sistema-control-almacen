<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.DetallesFacturaController">
   <children>

      <VBox layoutY="36.0" prefHeight="544.0" prefWidth="810.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="36.0">
         <effect>
            <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0" />
         </effect>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="label-titulo" text="Detalles de Factura:">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label fx:id="lb_folio" text="FOLIO" textFill="#044c87">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Separator prefWidth="200.0" />

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  
                  <VBox prefWidth="320.0" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
                     <children>
                        <Label text="Información General" textFill="#044c87">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Separator />
                        
                        <GridPane hgap="10.0" vgap="15.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="NEVER" minWidth="90.0" />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <Label text="Folio:" textFill="#666666">
                                  <font><Font name="System Bold" size="13.0" /></font>
                              </Label>
                              <Label fx:id="lb_folioFactura" text="-" GridPane.columnIndex="1" />
                              
                              <Label text="Fecha:" textFill="#666666" GridPane.rowIndex="1">
                                  <font><Font name="System Bold" size="13.0" /></font>
                              </Label>
                              <Label fx:id="lb_fecha" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              
                              <Label text="RFC:" textFill="#666666" GridPane.rowIndex="2">
                                  <font><Font name="System Bold" size="13.0" /></font>
                              </Label>
                              <Label fx:id="lb_rfc" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                              
                              <Label text="Razón Social:" textFill="#666666" GridPane.rowIndex="3">
                                  <font><Font name="System Bold" size="13.0" /></font>
                              </Label>
                              <Label fx:id="lb_razonSocial" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                              
                              <Label text="Domicilio:" textFill="#666666" GridPane.rowIndex="4">
                                  <font><Font name="System Bold" size="13.0" /></font>
                              </Label>
                              <Label fx:id="lb_domicilio" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                              
                              <Label text="Teléfono:" textFill="#666666" GridPane.rowIndex="5">
                                  <font><Font name="System Bold" size="13.0" /></font>
                              </Label>
                              <Label fx:id="lbl_telefono" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Items Ingresados" textFill="#044c87">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <TableView fx:id="tvMateriales" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="col_item" prefWidth="200.0" text="Item" />
                            <TableColumn fx:id="col_cantidad" prefWidth="100.0" text="Cantidad" />
                            <TableColumn fx:id="col_costoUnitario" prefWidth="120.0" text="Costo Unitario ($)" />
                          </columns>
                        </TableView>
                     </children>
                  </VBox>
                  
               </children>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#clicRegresar" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Regresar" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
