<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.KardexController">
   <children>

      <VBox layoutY="39.0" prefHeight="511.0" prefWidth="810.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="39.0">
         <effect>
            <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0" />
         </effect>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <Label styleClass="label-titulo" text="Kardex de Artículo">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label text="Consulte el historial de costos de un item" textFill="#666666" />

            <Separator prefWidth="200.0" />

            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Item:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="lb_descripcion" text="DESCRIPCIÓN DEL ITEM" textFill="#044c87">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <TableView fx:id="tv_kardex" prefHeight="337.0" prefWidth="768.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="col_folio" prefWidth="170.0" text="Folio de la Factura" />
                <TableColumn fx:id="col_fechaFactura" prefWidth="166.0" text="Fecha" />
                <TableColumn fx:id="col_costoUnitario" prefWidth="222.0" text="Costo Unitario ($)" />
                <TableColumn fx:id="col_costoPromedio" prefWidth="209.0" text="Costo Promedio ($)" />
              </columns>
            </TableView>

         </children>
      </VBox>
      <Button alignment="CENTER" contentDisplay="CENTER" layoutX="734.0" layoutY="561.0" mnemonicParsing="false" onAction="#clicRegresar" prefHeight="25.0" prefWidth="84.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Regresar" />
   </children>
</AnchorPane>
