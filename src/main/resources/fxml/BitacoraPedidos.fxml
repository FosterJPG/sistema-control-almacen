<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.BitacoraPedidosController">

   <children>

      <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <menus>
            <Menu mnemonicParsing="false" text="Ingresos">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#clicRegistrarFactura" text="Registrar factura" />
                  <MenuItem mnemonicParsing="false" onAction="#clicConsultarFacturas" text="Consultar facturas" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Items">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#clicRegistrarItem" text="Registrar item" />
                  <MenuItem mnemonicParsing="false" onAction="#clicConsultarItems" text="Consultar items" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Pedidos">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#clicConsultarBitacora" text="Consultar bitácora" />
               </items>
            </Menu>
         </menus>
      </MenuBar>

      <VBox layoutY="38.0" prefHeight="542.0" prefWidth="810.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="38.0">
         <effect>
            <DropShadow color="#0000003c" height="31.0" offsetX="-3.0" offsetY="5.0" radius="15.0" width="31.0" />
         </effect>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <Label styleClass="label-titulo" text="Bitácora de Pedidos (Reabastecimiento)">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label text="Gestione los artículos que han alcanzado su stock mínimo y requieren ser ordenados." textFill="#666666" />

            <Separator prefWidth="200.0" />

            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <TableView fx:id="tv_bitacora" prefHeight="250.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="col_idItem" prefWidth="117.0" text="Código del Item" />
                <TableColumn fx:id="col_descripcion" prefWidth="335.0" text="Descripción" />
                <TableColumn fx:id="col_existencias" prefWidth="97.0" text="Existencias" />
                <TableColumn fx:id="col_stockMin" prefWidth="99.0" text="Stock Mínimo" />
                <TableColumn fx:id="col_fecha" prefWidth="119.0" text="Fecha" />
              </columns>
               <effect>
                  <DropShadow color="#0000002e" height="28.42" offsetX="-3.0" offsetY="3.0" radius="15.5625" width="35.83" />
               </effect>
               </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#clicExportarExcel" style="-fx-background-color: #1E71A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Exportar a Excel" />
                  <Button mnemonicParsing="false" onAction="#clicRegresar" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Regresar" />
               </children>
               <effect>
                  <DropShadow color="#00000039" height="40.83" offsetX="-3.0" offsetY="3.0" radius="21.5675" spread="0.19" width="47.44" />
               </effect>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
