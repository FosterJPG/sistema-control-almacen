<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="390.0" prefWidth="520.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uv.lis.controlalmacen.controladores.EditarUsuarioController">
    <children>
        <VBox spacing="15.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;"
              AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <effect>
                <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0"/>
            </effect>
            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="20.0"/>
            </padding>
            <children>

                <Label text="Modificar Usuario" textFill="#044c87">
                    <font><Font name="System Bold" size="18.0"/></font>
                </Label>
                <Label text="Cambia el rol o la contraseña del usuario. Deja la contraseña en blanco para no modificarla."
                       textFill="#666666" wrapText="true">
                    <font><Font size="13.0"/></font>
                </Label>

                <Separator/>

                <GridPane hgap="15.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="160.0" prefWidth="160.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
                    </columnConstraints>
                    <children>
                        <Label text="ID de usuario:" GridPane.rowIndex="0">
                            <font><Font name="System Bold" size="13.0"/></font>
                        </Label>
                        <Label fx:id="lblIdUsuario" textFill="#044c87" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <font><Font name="System Bold" size="13.0"/></font>
                        </Label>

                        <Label text="Empleado:" GridPane.rowIndex="1">
                            <font><Font name="System Bold" size="13.0"/></font>
                        </Label>
                        <Label fx:id="lblNombre" textFill="#444444" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Rol de usuario:" GridPane.rowIndex="2">
                            <font><Font name="System Bold" size="13.0"/></font>
                        </Label>
                        <ComboBox fx:id="cbRol" prefHeight="30.0" prefWidth="270.0"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Nueva contraseña:" GridPane.rowIndex="3">
                            <font><Font name="System Bold" size="13.0"/></font>
                        </Label>
                        <PasswordField fx:id="pfPassword" prefHeight="30.0" prefWidth="270.0"
                                       promptText="Dejar en blanco para no cambiar"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Confirmar contraseña:" GridPane.rowIndex="4">
                            <font><Font name="System Bold" size="13.0"/></font>
                        </Label>
                        <PasswordField fx:id="pfConfirmar" prefHeight="30.0" prefWidth="270.0"
                                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    </children>
                </GridPane>

                <Label fx:id="lblError" textFill="#b50202" wrapText="true" prefHeight="20.0"/>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#clicCancelar"
                                prefHeight="32.0" prefWidth="100.0"
                                style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                                text="Cancelar"/>
                        <Button mnemonicParsing="false" onAction="#clicGuardar"
                                prefHeight="32.0" prefWidth="150.0"
                                style="-fx-background-color: #044c87; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                                text="Guardar Cambios">
                            <effect><InnerShadow color="#ffffff40" offsetY="3.0"/></effect>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
