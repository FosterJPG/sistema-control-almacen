<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.MenuPrincipalCentralController">
   <children>

      <Button fx:id="btnCerrarSesion" mnemonicParsing="false" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: transparent; -fx-text-fill: #dc3545; -fx-border-color: #dc3545; -fx-border-radius: 5;" text="Cerrar Sesión" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="30.0">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Label text="Panel de Administración Central" textFill="#007bff" AnchorPane.leftAnchor="40.0" AnchorPane.topAnchor="30.0">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>

      <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 15;" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="100.0">
         <effect>
            <DropShadow color="#00000026" offsetX="0.0" offsetY="5.0" radius="15.0" />
         </effect>
         <children>
            <Label text="Seleccione un módulo para gestionar los recursos globales del sistema." textFill="#666666">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>

            <HBox alignment="CENTER" spacing="50.0">
               <children>

                  <Button fx:id="btnUsuarios" mnemonicParsing="false" prefHeight="140.0" prefWidth="140.0" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
                     <graphic>
                        <VBox alignment="CENTER" spacing="15.0">
                           <children>
                              <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../imagenes/usuario (1).png" />
                                 </image>
                              </ImageView>
                              <Label text="Usuarios" textFill="#495057">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </graphic>
                  </Button>

                  <Button fx:id="btnSucursales" mnemonicParsing="false" prefHeight="140.0" prefWidth="140.0" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
                     <graphic>
                        <VBox alignment="CENTER" spacing="15.0">
                           <children>
                              <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../imagenes/grafico-de-barras.png" />
                                 </image>
                              </ImageView>
                              <Label text="Sucursales" textFill="#495057">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </graphic>
                  </Button>

               </children>
               <padding>
                  <Insets top="30.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
