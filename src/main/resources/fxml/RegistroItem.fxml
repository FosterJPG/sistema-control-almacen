<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.RegistroItemController">
   <children>

      <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <menus>
            <Menu mnemonicParsing="false" text="Ingresos">
               <items>
                  <MenuItem mnemonicParsing="false" text="Registrar factura" />
                  <MenuItem mnemonicParsing="false" text="Consultar facturas" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Items">
               <items>
                  <MenuItem mnemonicParsing="false" text="Registrar item" />
                  <MenuItem mnemonicParsing="false" text="Consultar items" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Pedidos">
               <items>
                  <MenuItem mnemonicParsing="false" text="Consultar bitácora" />
               </items>
            </Menu>
         </menus>
      </MenuBar>

      <VBox layoutY="40.0" prefHeight="540.0" prefWidth="810.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="40.0">
         <effect>
            <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0" />
         </effect>
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>
            
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="label-titulo" text="Registro de Nuevo Ítem">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label text="Llene los campos a continuación para dar de alta un producto en el catálogo general." textFill="#666666">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Separator prefWidth="200.0" />

            <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
               <children>
                  <GridPane hgap="15.0" maxWidth="550.0" style="-fx-background-color: #f8f9fa; -fx-padding: 30; -fx-background-radius: 8; -fx-border-color: #dee2e6; -fx-border-radius: 8;" vgap="25.0">
                    <columnConstraints>
                      <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="140.0" />
                      <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="Descripción:" textFill="#495057">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtDescripcion" promptText="Ej. Resma de papel bond tamaño carta" GridPane.columnIndex="1" />
                        
                        <Label text="Partida Presupuestal:" textFill="#495057" GridPane.rowIndex="1">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="cbPartidaPresupuestal" prefWidth="300.0" promptText="Seleccione una partida..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
               </children>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button fx:id="btnRegresar" mnemonicParsing="false" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Cancelar" />
                  <Button fx:id="btnRegistrar" mnemonicParsing="false" prefHeight="35.0" prefWidth="220.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Registrar Ítem en Catálogo">
                     <effect>
                        <InnerShadow color="#ffffff6d" offsetY="10.0" />
                     </effect></Button>
               </children>
               <effect>
                  <DropShadow color="#00000079" offsetX="-3.0" offsetY="3.0" />
               </effect>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
