<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.ItemsEnAlmacenController">
   <children>
      <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <effect>
            <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0" />
         </effect>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <Label styleClass="label-titulo" text="Inventario en Almacén">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label text="Gestione las existencias físicas y los límites de stock para cada artículo." textFill="#666666" />

            <Separator prefWidth="200.0" />

            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Filtros:">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cbPartidaPresupuestal" prefWidth="180.0" promptText="Partida Presupuestal..." />
                  <ComboBox fx:id="cbFiltroStock" prefWidth="180.0" promptText="Nivel de Stock..." />
                  
                  <Region HBox.hgrow="ALWAYS" /> <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Buscar producto..." />
               </children>
            </HBox>

            <TableView fx:id="tvInventario" prefHeight="250.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colIdItem" prefWidth="59.0" text="ID Ítem" />
                <TableColumn fx:id="colDescripcion" prefWidth="341.0" text="Descripción del Producto" />
                <TableColumn fx:id="colExistencias" prefWidth="122.0" text="Existencias" />
                <TableColumn fx:id="colStockMin" prefWidth="115.0" text="Stock Mínimo" />
                <TableColumn fx:id="colStockMax" prefWidth="130.0" text="Stock Máximo" />
              </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button fx:id="btnRegresar" mnemonicParsing="false" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Regresar" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
