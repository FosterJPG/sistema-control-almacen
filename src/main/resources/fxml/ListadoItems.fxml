<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.ListadoItemsController">
   <children>

      <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <menus>
            <Menu mnemonicParsing="false" text="Ingresos">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#clicRegistrarFactura" text="Registrar factura" />
                  <MenuItem mnemonicParsing="false" onAction="#clicConsultarFacturas" text="Consultar facturas" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Items">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#clicRegistrarItem" text="Registrar item" />
                  <MenuItem mnemonicParsing="false" onAction="#clicConsultarItems" text="Consultar items" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Pedidos">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#clicConsultarBitacora" text="Consultar bitácora" />
               </items>
            </Menu>
         </menus>
      </MenuBar>

      <VBox layoutY="40.0" prefHeight="540.0" prefWidth="810.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="40.0">
         <effect>
            <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0" />
         </effect>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <Label styleClass="label-titulo" text="Inventario en Almacén">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label text="Gestione las existencias físicas y los límites de stock para cada artículo." textFill="#666666" />

            <Separator prefWidth="200.0" />

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <children>

                   <ComboBox fx:id="cb_filtroBusqueda" prefWidth="130.0" promptText="Buscar por" />

                   <TextField fx:id="txt_buscarIdProducto" prefWidth="210.0" />

                   <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#clicBuscarItemAlmacenado" prefHeight="25.0" prefWidth="47.0" style="-fx-background-color: #044C87; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="🔍" />

                   <Region HBox.hgrow="ALWAYS" />
                </children>
             </HBox>
            <TitledPane animated="false" expanded="false" style="-fx-background-color: white; -fx-border-color: white; -fx-background-insets: 0; -fx-border-insets: 0;" text="Filtros">
               <content>
                  <HBox prefHeight="55.0" prefWidth="769.0" spacing="10.0" style="-fx-background-color: transparent;">
                     <children>
      
                         <ComboBox fx:id="cb_filtroStock" prefHeight="25.0" prefWidth="142.0" promptText="Nivel de Stock" visibleRowCount="3" />
      
                         <ComboBox fx:id="cb_partidaPresupuestal" editable="true" prefWidth="180.0" promptText="Buscar partida" />
                     </children>
                  </HBox>
               </content>
            </TitledPane>

            <TableView fx:id="tv_inventario" prefHeight="250.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="col_idItem" prefWidth="71.0" text="Código" />
                  <TableColumn fx:id="col_partida" prefWidth="158.0" text="Partida Presupuestal" />
                <TableColumn fx:id="col_descripcion" prefWidth="291.0" text="Descripción" />
                <TableColumn fx:id="col_existencias" prefWidth="78.0" text="Existencias" />
                <TableColumn fx:id="col_stockMin" prefWidth="84.0" text="Stock Mínimo" />
                <TableColumn fx:id="col_stockMax" prefWidth="90.0" text="Stock Máximo" />
              </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#clicExportar" prefHeight="25.0" prefWidth="121.0" style="-fx-background-color: #044C87; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Exportar reporte" />
                  <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#clicVerKardex" prefHeight="25.0" prefWidth="87.0" style="-fx-background-color: #399ACE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Ver Kardex" />
                  <Button mnemonicParsing="false" onAction="#clicRegresar" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Regresar" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
