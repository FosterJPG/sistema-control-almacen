<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="720.0" prefWidth="500.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.RegistroEmpleadoController">
    <children>
        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dee2e6; -fx-border-radius: 12;" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <effect>
                <DropShadow color="#00000026" offsetX="0.0" offsetY="5.0" radius="10.0" />
            </effect>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <VBox spacing="2.0">
                    <children>
                        <Label fx:id="lbl_titulo" text="Registro de Nuevo Empleado" textFill="#1a365d">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Label text="Llene los campos para registrar al personal." textFill="#666666" wrapText="true">
                            <font><Font size="13.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <Separator prefWidth="200.0" />

                <GridPane hgap="10.0" maxWidth="450.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #dee2e6; -fx-border-radius: 8;" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="130.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>

                        <Label text="Nombre(s):" textFill="#495057">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_nombre" prefHeight="30.0" promptText="Ej. Juan Carlos" GridPane.columnIndex="1" />

                        <Label text="Apellido Paterno:" textFill="#495057" GridPane.rowIndex="1">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_paterno" prefHeight="30.0" promptText="Ej. Pérez" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Apellido Materno:" textFill="#495057" GridPane.rowIndex="2">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_materno" prefHeight="30.0" promptText="Opcional" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Dirección:" textFill="#495057" GridPane.rowIndex="3">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_direccion" prefHeight="30.0" promptText="Ej. Av. Revolución 123" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Teléfono:" textFill="#495057" GridPane.rowIndex="4">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_telefono" prefHeight="30.0" promptText="10 dígitos" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Correo Electrónico:" textFill="#495057" GridPane.rowIndex="5">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextField fx:id="txt_correo" prefHeight="30.0" promptText="Opcional: usuario@ejemplo.com" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <Label fx:id="lbl_puesto" text="Puesto:" textFill="#495057" GridPane.rowIndex="7">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <ComboBox fx:id="cb_puesto" editable="true" prefHeight="30.0" prefWidth="300.0" promptText="Seleccione puesto..." GridPane.columnIndex="1" GridPane.rowIndex="7" />

                        <Label fx:id="lbl_sucursal" text="Sucursal Base:" textFill="#495057" GridPane.rowIndex="6">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <ComboBox fx:id="cb_sucursal" editable="true" prefHeight="30.0" prefWidth="300.0" promptText="Seleccione sucursal..." GridPane.columnIndex="1" GridPane.rowIndex="6" />

                        <Label fx:id="lbl_departamento" text="Departamento:" textFill="#495057" GridPane.rowIndex="8">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <ComboBox fx:id="cb_departamento" editable="true" prefHeight="30.0" prefWidth="300.0" promptText="Seleccione departamento..." GridPane.columnIndex="1" GridPane.rowIndex="8" />
                  <Label fx:id="lbl_mensajeError" textFill="#860202" GridPane.columnIndex="1" GridPane.rowIndex="9" />

                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#clicCancelar" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Cancelar" />
                        <Button mnemonicParsing="false" onAction="#clicRegistrar" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #044c87; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Guardar">
                            <effect>
                                <InnerShadow color="#ffffff6d" offsetY="3.0" />
                            </effect>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
