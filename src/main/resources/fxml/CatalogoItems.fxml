<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.CatalogoItemsController">
   <children>

      <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <menus>
            <Menu mnemonicParsing="false" text="Ingresos">
               <items>
                  <MenuItem mnemonicParsing="false" text="Registrar factura" />
                  <MenuItem mnemonicParsing="false" text="Consultar facturas" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Items">
               <items>
                  <MenuItem mnemonicParsing="false" text="Registrar item" />
                  <MenuItem mnemonicParsing="false" text="Consultar items" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Pedidos">
               <items>
                  <MenuItem mnemonicParsing="false" text="Consultar bitácora" />
               </items>
            </Menu>
         </menus>
      </MenuBar>

      <VBox layoutY="37.0" prefHeight="543.0" prefWidth="810.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="37.0">
         <effect>
            <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0" />
         </effect>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>

            <Label styleClass="label-titulo" text="Catálogo General de Ítems" textFill="#044c87">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label text="Consulte todos los productos registrados en el sistema y su clasificación presupuestal." textFill="#666666" />

            <Separator prefWidth="200.0" />

            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Filtrar por Partida:" textFill="#044c87">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cbPartidaPresupuestal" prefHeight="30.0" prefWidth="220.0" promptText="Todas las partidas..." />

                  <Region HBox.hgrow="ALWAYS" />

                  <TextField fx:id="txtBuscar" prefHeight="30.0" prefWidth="205.0" promptText="Buscar por descripción..." />

                  <Button mnemonicParsing="false" onAction="#clicBuscar" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #399ACE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Buscar">
                     <effect>
                        <InnerShadow color="#ffffff40" offsetY="3.0" />
                     </effect>
                  </Button>
               </children>
            </HBox>

            <TableView fx:id="tvCatalogo" onSort="#tv_listado" prefHeight="250.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colIdItem" onEditStart="#col_idColuma" prefWidth="80.0" text="ID Ítem" />
                  <TableColumn fx:id="colDescripcion" onEditStart="#col_descripcionColuma" prefWidth="420.0" text="Descripción del Producto" />
                  <TableColumn fx:id="colPartida" onEditStart="#col_partidaColuma" prefWidth="267.0" text="Partida Presupuestal" />
               </columns>
               <effect>
                  <DropShadow offsetX="-3.0" offsetY="3.0">
                     <color>
                        <Color opacity="0.15" />
                     </color>
                  </DropShadow>
               </effect>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#clicAgregar" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #044c87; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Agregar">
                     <effect>
                        <InnerShadow color="#ffffff40" offsetY="3.0" />
                     </effect>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#clicModificar" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #399ACE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Modificar">
                     <effect>
                        <InnerShadow color="#ffffff40" offsetY="3.0" />
                     </effect>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#clicEliminar" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #399ACE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Eliminar">
                     <effect>
                        <InnerShadow color="#ffffff40" offsetY="3.0" />
                     </effect>
                  </Button>

                  <Region HBox.hgrow="ALWAYS" />

                  <Button mnemonicParsing="false" onAction="#clicRegresar" prefHeight="30.0" prefWidth="140.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Regresar al Menú">
                     <effect>
                        <InnerShadow color="#ffffff40" offsetY="3.0" />
                     </effect>
                  </Button>
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
