<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.RegistroFacturaController">
    <children>

        <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <menus>
                <Menu mnemonicParsing="false" text="Ingresos">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Registrar factura" />
                        <MenuItem mnemonicParsing="false" onAction="#clicConsultarFacturas" text="Consultar facturas" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Items">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#clicRegistrarItem" text="Registrar item" />
                        <MenuItem mnemonicParsing="false" onAction="#clicConsultarItems" text="Consultar items" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Pedidos">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#clicConsultarBitacora" text="Consultar bitácora" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="40.0">
            <effect>
                <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0" />
            </effect>
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>

                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="label-titulo" text="Registro de Nueva Factura">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Separator prefWidth="200.0" />

                <HBox spacing="25.0" VBox.vgrow="ALWAYS">
                    <children>

                        <VBox prefWidth="380.0" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #dee2e6; -fx-border-radius: 8;">
                            <children>
                                <Label text="1. Información de Factura" textFill="#044c87">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Separator />
                                <GridPane hgap="10.0" vgap="15.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="NEVER" minWidth="90.0" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Folio:" textFill="#495057"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <TextField fx:id="txt_folio" GridPane.columnIndex="1" />

                                        <Label text="Fecha:" textFill="#495057" GridPane.rowIndex="1"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <DatePicker fx:id="dp_fecha" prefWidth="300.0" promptText="Seleccione fecha..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Proveedor:" textFill="#495057" GridPane.rowIndex="2"><font><Font name="System Bold" size="13.0" /></font></Label>

                                        <Label text="Razón Social:" textFill="#495057" GridPane.rowIndex="3"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <TextField fx:id="txt_razonSocial" editable="false" promptText="Autocompletado" style="-fx-background-color: #e9ecef;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label text="Domicilio:" textFill="#495057" GridPane.rowIndex="4"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <TextField fx:id="txt_domicilio" editable="false" promptText="Autocompletado" style="-fx-background-color: #e9ecef;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                        <Label text="Teléfono:" textFill="#495057" GridPane.rowIndex="5"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <TextField fx:id="txt_telefono" editable="false" promptText="Autocompletado" style="-fx-background-color: #e9ecef;" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                              <TextField fx:id="txt_rfc" promptText="RFC" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="2. Materiales Adquiridos" textFill="#044c87">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Separator />

                                <GridPane hgap="15.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="NEVER" minWidth="60.0" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                        <ColumnConstraints hgrow="NEVER" minWidth="60.0" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" percentHeight="100.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" percentHeight="100.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Item:"><font><Font name="System Bold" size="13.0" /></font></Label>

                                        <Label text="Cantidad:" GridPane.rowIndex="1"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <TextField fx:id="txt_cantidad" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label prefHeight="19.0" prefWidth="116.0" text="Costo Unitario:" GridPane.rowIndex="2"><font><Font name="System Bold" size="13.0" /></font></Label>
                                        <TextField fx:id="txt_costoUnitario" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <Button mnemonicParsing="false" onAction="#clicEliminarItem" prefHeight="25.0" prefWidth="62.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Quitar" GridPane.columnIndex="2" GridPane.rowIndex="2">
                                 <effect>
                                    <InnerShadow offsetY="9.0">
                                       <color>
                                          <Color blue="1.0" green="1.0" opacity="0.44155845046043396" red="1.0" />
                                       </color>
                                    </InnerShadow>
                                 </effect>
                              </Button>
                                        <Button mnemonicParsing="false" onAction="#clicAgregarItem" style="-fx-background-color: #044c87; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Agregar" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                 <effect>
                                    <InnerShadow offsetY="9.0">
                                       <color>
                                          <Color blue="1.0" green="1.0" opacity="0.44155845046043396" red="1.0" />
                                       </color>
                                    </InnerShadow>
                                 </effect></Button>
                              <TextField fx:id="txt_idItem" promptText="Código" GridPane.columnIndex="1" />
                                    </children>
                                </GridPane>

                                <HBox alignment="CENTER_RIGHT" prefHeight="21.0" prefWidth="541.0" spacing="10.0">
                           <effect>
                              <DropShadow offsetX="-3.0" offsetY="3.0">
                                 <color>
                                    <Color opacity="0.36796537041664124" />
                                 </color>
                              </DropShadow>
                           </effect>
                                </HBox>

                                <TableView fx:id="tv_detalleFactura" prefHeight="252.0" prefWidth="578.0" VBox.vgrow="ALWAYS">
                                    <columns>
                              <TableColumn fx:id="col_idItem" prefWidth="85.0" text="Código" />
                                        <TableColumn fx:id="col_descripcion" prefWidth="217.0" text="Descripción" />
                                        <TableColumn fx:id="col_cantidad" prefWidth="83.0" text="Cantidad" />
                                        <TableColumn fx:id="col_costoUnitario" prefWidth="116.0" text="Costo Unitario" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#clicCancelar" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Cancelar" />
                        <Button mnemonicParsing="false" onAction="#clicGuardarFactura" prefHeight="35.0" prefWidth="200.0" style="-fx-background-color: #399ACE; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Guardar factura">
                            <effect>
                                <InnerShadow color="#ffffff4d" offsetY="10.0" />
                            </effect></Button>
                    </children>
                    <effect>
                        <DropShadow color="#00000059" offsetX="-3.0" offsetY="3.0" />
                    </effect>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
