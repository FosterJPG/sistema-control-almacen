<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.controlalmacen.controladores.ListadoFacturasController">
   <children>
      <VBox layoutX="19.0" layoutY="40.0" prefHeight="637.0" prefWidth="813.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="23.0" AnchorPane.leftAnchor="19.0" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="40.0">
         <effect>
            <DropShadow color="#00000020" offsetX="0.0" offsetY="5.0" radius="15.0" />
         </effect>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <Label styleClass="label-titulo" text="Registro de Facturas (Ingresos)">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label text="Historial completo de facturas de compra recibidas por proveedores." textFill="#666666" />

            <Separator prefWidth="200.0" />

            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Filtrar por:">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <DatePicker fx:id="dpFechaFactura" promptText="Fecha de factura..." />
                  
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Buscar por folio o RFC..." />
               </children>
            </HBox>

            <TableView fx:id="tvFacturas" prefHeight="250.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colFolio" prefWidth="293.0" text="Folio" />
                <TableColumn fx:id="colFecha" prefWidth="160.0" text="Fecha Factura" />
                <TableColumn fx:id="colProveedor" prefWidth="314.0" text="RFC Proveedor" />
              </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button fx:id="btnVerDetalles" mnemonicParsing="false" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Ver Detalles de Factura">
                     <effect>
                        <InnerShadow color="#ffffff5c" offsetY="9.0" />
                     </effect></Button>
                  <Button mnemonicParsing="false" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Generar reporte">
                     <effect>
                        <InnerShadow color="#00000021" height="11.0" offsetY="-8.0" radius="7.5" />
                     </effect>
                  </Button>
                  <Button fx:id="btnRegresar" mnemonicParsing="false" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Regresar" />
               </children>
               <effect>
                  <DropShadow color="#0000006f" offsetX="-3.0" offsetY="3.0" />
               </effect>
            </HBox>

         </children>
      </VBox>
      <MenuBar layoutY="-2.0" prefHeight="32.0" prefWidth="850.0">
        <menus>
          <Menu mnemonicParsing="false" text="Ingresos">
            <items>
              <MenuItem mnemonicParsing="false" text="Registrar factura" />
                  <MenuItem mnemonicParsing="false" text="Consultar facturas" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Items">
            <items>
              <MenuItem mnemonicParsing="false" text="Registrar item" />
                  <MenuItem mnemonicParsing="false" text="Consultar items" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Pedidos">
            <items>
              <MenuItem mnemonicParsing="false" text="Consultar bitácora" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </children>
</AnchorPane>
